# Normalize source and documentation across macOS, Linux, and Windows.
* text=auto

*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Fixed media and document assets are binary. Runtime media stays ignored.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.pdf binary
