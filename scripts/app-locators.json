    "market": {
      "_中文": "大盤",
      "targets": {
        "加權指數磚": {
          "_說明": "三磚並排、加權指數在最左；用左邊界起算取左 1/3 磚",
          "anchor": {
            "all": [
              "加權指數"
            ],
            "yBand": [
              0.35,
              0.6
