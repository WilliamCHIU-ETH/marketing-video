{
  "_說明": "App 截圖標注規則庫。每個 page 底下每個 target = 一條定位規則。座標全用畫面比例(frac)，尺寸無關。",
  "_用法": "node scripts/app-locate.js <圖片> <page.target> [--draw 輸出.png]（動態值用 --anchor \"+31,513.3\"）",
  "_anchor欄位": "all=該行需同時包含的字；word=對齊行內某個字的x；yBand=[上,下]用畫面高度比例挑對的那一個；runtime=改由 --anchor 傳當天的字",
  "_expand型別": "rowFull整列 / rowRight錨點往右 / card卡片(below=在錨點下方) / tile磚 / box錨點小框 / region純比例區(給沒文字可錨的圖)",
  "pages": {
    "chip-daily": {
      "_中文": "籌碼日報",
      "targets": {
        "統計天數列": {
          "anchor": {
            "all": [
              "統計",
              "天數"
            ]
          },
          "expand": {
            "type": "rowFull",
            "marginX": 0.012,
            "padY": 0.006
          }
        },
        "提醒卡": {
          "_說明": "『提醒！』黃底膠囊那條（買超佔比）。提醒二字被樣式化不好認，改錨旁邊穩定的『短沖…券商』",
          "anchor": {
            "all": [
              "短沖",
              "券商"
            ]
          },
          "expand": {
            "type": "card",
            "marginX": 0.02,
            "padTop": 0.016,
            "heightFrac": 0.052
          }
        },
        "券商損益": {
          "_說明": "動態：--anchor 傳當天要框的損益數字，例如 +31,513.3",
          "anchor": {
            "runtime": true
          },
          "expand": {
            "type": "box",
            "pad": 0.03
          }
        }
      }
    },
    "legal-person": {
      "_中文": "法人",
      "targets": {
        "摘要卡": {
          "_說明": "AI 摘要卡標題每天不同、上方分頁名又常認不清；改錨『下方』穩定的子分頁列『八大行庫』往上框",
          "anchor": {
            "all": [
              "三大法人"
            ],
            "yBand": [
              0.35,
              0.48
            ]
          },
          "expand": {
            "type": "card",
            "above": true,
            "gap": 0.012,
            "marginX": 0.02,
            "heightFrac": 0.105
          }
        },
        "法人日表數字": {
          "anchor": {
            "runtime": true
          },
          "expand": {
            "type": "box",
            "pad": 0.03
          }
        }
