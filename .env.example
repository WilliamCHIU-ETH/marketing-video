# Local server defaults. HOST=127.0.0.1 keeps the app on this Mac only.
HOST=127.0.0.1
PORT=4000
DATA_DIR=./runtime-data
KEEP_RECENT=20
KEEP_DAYS=7
DISABLE_WORKER=0
AUTO_PRUNE_ON_START=0

# Local ASR: whisper.cpp CLI + pinned quantized model (model file is ignored by Git)
WHISPER_MODEL_PATH=.cache/whisper/ggml-base-q5_1.bin
WHISPER_MODEL_SHA256=422f1ae452ade6f30a004d7e5c6a43195e4433bc370bf23fac9cc591f01a8898
WHISPER_THREADS=4
WHISPER_DEVICE=cpu

# Paid providers are optional for localhost startup and smoke tests.
HEYGEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
OPENAI_API_KEY=

# Optional ChipK Capture 0.2.1 executable. No intent and disable-capture never probe it.
# Keep the absolute, machine-local path in .env only; do not commit it.
CHIPK_CAPTURE_BIN=

# Only enable after adding proper access control for LAN users.
ALLOW_INSECURE_LAN=0
ALLOW_INSECURE_ADMIN_QUERY=0
