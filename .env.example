# Local server defaults. HOST=127.0.0.1 keeps the app on this Mac only.
HOST=127.0.0.1
PORT=4000
DATA_DIR=./runtime-data
KEEP_RECENT=20
KEEP_DAYS=7
DISABLE_WORKER=0
AUTO_PRUNE_ON_START=0

# Paid providers are optional for localhost startup and smoke tests.
HEYGEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
OPENAI_API_KEY=

# Only enable after adding proper access control for LAN users.
ALLOW_INSECURE_LAN=0
ALLOW_INSECURE_ADMIN_QUERY=0
